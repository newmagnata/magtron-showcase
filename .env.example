# Obrigatório em produção. Gere com: openssl rand -hex 32
APP_SECRET=

# Vazio: usa o Postgres embutido em .data/pg (só para desenvolvimento)
DATABASE_URL=

# Cadastro de novas empresas: fechado depois do primeiro usuário. Equipe entra por convite.
# Use true só se quiser cadastro público.
ALLOW_REGISTRATION=false

# true quando há proxy na frente (Caddy, Tailscale Serve): o IP real vem do cabeçalho. Nunca com a porta aberta para a internet.
TRUST_PROXY=false

# Pedidos por minuto por IP (webhooks e mídia ficam de fora)
RATE_LIMIT_MAX=300

PORT=3333
# Em servidor, use 0.0.0.0
HOST=127.0.0.1
# URL pública HTTPS. A Evolution e a Meta enviam os webhooks para cá.
PUBLIC_URL=http://localhost:3333

# Padrões usados quando a conexão não informa os seus
EVOLUTION_URL=
EVOLUTION_API_KEY=

# Necessária para os blocos e agentes de IA
ANTHROPIC_API_KEY=
